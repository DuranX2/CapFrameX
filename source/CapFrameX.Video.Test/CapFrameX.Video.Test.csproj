<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Platforms>AnyCPU;x64</Platforms>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <IsPackable>false</IsPackable>
    <!-- MSTEST0044: [DataTestMethod]/[DataRow] are obsolete in favor of the new
         dynamic data APIs, but the repo-wide test suite still uses them; keep the
         build warning-free until the suite migrates. -->
    <NoWarn>$(NoWarn);MSTEST0044</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="MSTest.TestAdapter" />
    <PackageReference Include="MSTest.TestFramework" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CapFrameX.Video\CapFrameX.Video.csproj" />
  </ItemGroup>

</Project>
