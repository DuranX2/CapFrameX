<UserControl x:Class="CapFrameX.View.VideoView"
             x:Name="VideoViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:CapFrameX.MVVM.Localization;assembly=CapFrameX.MVVM"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prism="http://prismlibrary.com/"
             xmlns:dragdrop="urn:gong-wpf-dragdrop"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mvvm="clr-namespace:CapFrameX.MVVM.Converter;assembly=CapFrameX.MVVM"
             mc:Ignorable="d"
             d:DesignHeight="720" d:DesignWidth="1100"
             Background="{DynamicResource MaterialDesign.Brush.Card.Background}"
             Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
             prism:ViewModelLocator.AutoWireViewModel="True"
             dragdrop:DragDrop.IsDropTarget="True"
             dragdrop:DragDrop.DropHandler="{Binding}">
    <UserControl.Resources>
        <ResourceDictionary>
            <mvvm:BoolToVisibilityConverter x:Key="TrueToVisibleConverter" FalseValue="Collapsed" TrueValue="Visible"/>
            <mvvm:BoolToVisibilityConverter x:Key="FalseToVisibleConverter" FalseValue="Visible" TrueValue="Collapsed"/>

            <!-- One labeled metric box (value over label). -->
            <Style x:Key="VideoMetricBox" TargetType="{x:Type Border}">
                <Setter Property="Padding" Value="14 10 14 12"/>
                <Setter Property="Margin" Value="0 0 12 12"/>
                <Setter Property="Background" Value="{DynamicResource MaterialDesign.Brush.TextBox.FilledBackground}"/>
                <Setter Property="CornerRadius" Value="8"/>
            </Style>
            <Style x:Key="VideoMetricLabel" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.ForegroundLight}"/>
            </Style>
            <Style x:Key="VideoMetricValue" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="18"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0 3 0 0"/>
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
            </Style>
            <Style x:Key="VideoSectionTitle" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="15"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{DynamicResource MaterialDesign.Brush.Foreground}"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24 20 24 24" MaxWidth="980" HorizontalAlignment="Left">
            <!-- Empty-state hint -->
            <Border Style="{StaticResource VideoMetricBox}" Margin="0 0 0 12" Padding="20"
                    Visibility="{Binding IsIdle, Converter={StaticResource TrueToVisibleConverter}}">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <materialDesign:PackIcon Kind="VideoOutline" Width="34" Height="34" Margin="0 0 16 0"
                                             Opacity="0.6"
                                             Foreground="{DynamicResource MaterialDesign.Brush.Primary}"/>
                    <TextBlock Text="{loc:Tr VideoView_EmptyState}" FontSize="14" TextWrapping="Wrap" MaxWidth="560"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                </StackPanel>
            </Border>

            <!-- File selection -->
            <Border Style="{StaticResource VideoMetricBox}" Margin="0 0 0 12" Padding="16">
                <StackPanel>
                    <TextBlock Style="{StaticResource VideoSectionTitle}" Text="{loc:Tr VideoView_Title}"/>
                    <Grid Margin="0 12 0 0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Height="42" IsReadOnly="True"
                                 materialDesign:HintAssist.Hint="{loc:Tr VideoView_HintNoVideo}"
                                 materialDesign:HintAssist.IsFloating="True"
                                 materialDesign:HintAssist.HintOpacity=".8"
                                 Text="{Binding VideoFileLeaf, Mode=OneWay}"
                                 Style="{DynamicResource CxFloatingHintTextBox}"
                                 ToolTip="{Binding VideoPath}"/>
                        <Button Grid.Column="1" Margin="10 0 0 0" Height="42" MinWidth="110"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding OpenVideoCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOpen" Width="16" Height="16" Margin="0 0 8 0"
                                                         VerticalAlignment="Center" Foreground="White"/>
                                <TextBlock Text="{loc:Tr VideoView_Browse}" VerticalAlignment="Center" Foreground="White"/>
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Margin="8 0 0 0" Height="42" Padding="12 0"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding CancelCommand}"
                                Visibility="{Binding CanCancel, Converter={StaticResource TrueToVisibleConverter}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Close" Width="16" Height="16" Margin="0 0 6 0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr VideoView_Cancel}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- File facts (after the probe) -->
                    <StackPanel Orientation="Horizontal" Margin="0 10 0 0"
                                Visibility="{Binding HasMetrics, Converter={StaticResource TrueToVisibleConverter}}">
                        <StackPanel Orientation="Horizontal" Margin="0 0 18 0">
                            <TextBlock Style="{StaticResource VideoMetricLabel}" Text="{loc:Tr VideoView_Resolution}"/>
                            <TextBlock Style="{StaticResource VideoMetricLabel}" Margin="6 0 0 0"
                                       Text="{Binding ResolutionText, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0 0 18 0">
                            <TextBlock Style="{StaticResource VideoMetricLabel}" Text="{loc:Tr VideoView_Codec}"/>
                            <TextBlock Style="{StaticResource VideoMetricLabel}" Margin="6 0 0 0"
                                       Text="{Binding CodecText, Mode=OneWay}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource VideoMetricLabel}" Text="{loc:Tr VideoView_Duration}"/>
                            <TextBlock Style="{StaticResource VideoMetricLabel}" Margin="6 0 0 0"
                                       Text="{Binding DurationText, Mode=OneWay}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Busy / status / error line -->
            <Grid Margin="0 0 0 12"
                  Visibility="{Binding IsBusy, Converter={StaticResource TrueToVisibleConverter}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{Binding StatusText}" FontSize="13"
                           Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                <ProgressBar Grid.Column="1" Width="160" Height="4" VerticalAlignment="Center" IsIndeterminate="True"/>
            </Grid>
            <TextBlock Margin="0 0 0 12" Text="{Binding StatusText}" FontSize="13" TextWrapping="Wrap"
                       Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"
                       Visibility="{Binding IsBusy, Converter={StaticResource FalseToVisibleConverter}}"/>
            <Border Margin="0 0 0 12" Padding="12" CornerRadius="6"
                    Background="#33d50000"
                    Visibility="{Binding HasError, Converter={StaticResource TrueToVisibleConverter}}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon Kind="AlertCircle" Width="18" Height="18" Margin="0 1 10 0"
                                             VerticalAlignment="Top" Foreground="#d50000"/>
                    <TextBlock Text="{Binding ErrorText}" TextWrapping="Wrap" FontSize="13" Foreground="#d50000"/>
                </StackPanel>
            </Border>

            <!-- Metrics -->
            <Border Style="{StaticResource VideoMetricBox}" Padding="16" Margin="0 0 0 12"
                    Visibility="{Binding HasMetrics, Converter={StaticResource TrueToVisibleConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource VideoSectionTitle}" Text="{loc:Tr VideoView_PacingTitle}"/>
                    <WrapPanel Margin="0 12 0 0">
                        <Border Style="{StaticResource VideoMetricBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource VideoMetricLabel}" Text="{loc:Tr VideoView_NominalFps}"/>
                                <TextBlock Style="{StaticResource VideoMetricValue}" Text="{Binding NominalFpsText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource VideoMetricBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource VideoMetricLabel}" Text="{loc:Tr VideoView_MeasuredFps}"/>
                                <TextBlock Style="{StaticResource VideoMetricValue}" Text="{Binding MeasuredFpsText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource VideoMetricBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource VideoMetricLabel}" Text="{loc:Tr VideoView_BaseInterval}"/>
                                <TextBlock Style="{StaticResource VideoMetricValue}" Text="{Binding BaseIntervalText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource VideoMetricBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource VideoMetricLabel}" Text="{loc:Tr VideoView_Mode}"/>
                                <TextBlock Style="{StaticResource VideoMetricValue}" Text="{Binding ModeText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource VideoMetricBox}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource VideoMetricLabel}" Text="{loc:Tr VideoView_Jank}"/>
                                <TextBlock Style="{StaticResource VideoMetricValue}" Text="{Binding JankText}"/>
                            </StackPanel>
                        </Border>
                        <Border Style="{StaticResource VideoMetricBox}" Margin="0 0 0 0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource VideoMetricLabel}" Text="{loc:Tr VideoView_Frames}"/>
                                <TextBlock Style="{StaticResource VideoMetricValue}" Text="{Binding FrameCountText}"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!-- FPS per second -->
                    <TextBlock Style="{StaticResource VideoSectionTitle}" Margin="0 6 0 0"
                               Text="{loc:Tr VideoView_FpsOverTime}"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                                  Margin="0 8 0 0" MaxHeight="130">
                        <ItemsControl ItemsSource="{Binding Metrics.FpsOverTime}" Margin="0 0 4 4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Width="26" Margin="0 0 5 0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="96"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid Grid.Row="0">
                                            <Border Background="{DynamicResource MaterialDesign.Brush.TextBox.HoverBackground}"/>
                                            <Border VerticalAlignment="Bottom"
                                                    Background="{DynamicResource MaterialDesign.Brush.Primary}"
                                                    Height="{Binding HeightPx}"/>
                                        </Grid>
                                        <TextBlock Grid.Row="1" Text="{Binding Label}" FontSize="10"
                                                   HorizontalAlignment="Center" Opacity="0.6"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Burn -->
            <Border Style="{StaticResource VideoMetricBox}" Padding="16"
                    Visibility="{Binding HasMetrics, Converter={StaticResource TrueToVisibleConverter}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource VideoSectionTitle}" Text="{loc:Tr VideoView_BurnTitle}"/>
                    <TextBlock Margin="0 4 0 0" FontSize="12" TextWrapping="Wrap"
                               Foreground="{DynamicResource MaterialDesign.Brush.ForegroundLight}"
                               Text="{loc:Tr VideoView_BurnDescription}"/>

                    <StackPanel Orientation="Horizontal" Margin="0 14 0 12">
                        <!-- Uses the app-level implicit ToggleButton style (CxCompactSwitchToggleButton). -->
                        <ToggleButton Width="22" Height="22" VerticalAlignment="Center"
                                      IsChecked="{Binding IsLossless, Mode=TwoWay}"/>
                        <TextBlock Margin="10 0 0 0" VerticalAlignment="Center" FontSize="13"
                                   Text="{loc:Tr VideoView_Lossless}"/>
                    </StackPanel>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox Grid.Column="0" Height="42"
                                 materialDesign:HintAssist.Hint="{loc:Tr VideoView_OutputPath}"
                                 materialDesign:HintAssist.IsFloating="True"
                                 materialDesign:HintAssist.HintOpacity=".8"
                                 Text="{Binding OutputPath, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                 Style="{DynamicResource CxFloatingHintTextBox}"/>
                        <Button Grid.Column="1" Margin="10 0 0 0" Width="40" Height="42" Padding="0"
                                Style="{StaticResource MaterialDesignIconButton}"
                                Command="{Binding BrowseOutputCommand}"
                                ToolTip="{loc:Tr VideoView_OutputPath}">
                            <materialDesign:PackIcon Kind="Folder" Width="20" Height="20"/>
                        </Button>
                        <Button Grid.Column="2" Margin="8 0 0 0" Height="42" MinWidth="130"
                                Style="{StaticResource MaterialDesignRaisedButton}"
                                Command="{Binding BurnCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="Fire" Width="16" Height="16" Margin="0 0 8 0"
                                                         VerticalAlignment="Center" Foreground="White"/>
                                <TextBlock Text="{loc:Tr VideoView_Burn}" VerticalAlignment="Center" Foreground="White"/>
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Burn result -->
                    <StackPanel Orientation="Horizontal" Margin="0 12 0 0"
                                Visibility="{Binding HasBurnedOutput, Converter={StaticResource TrueToVisibleConverter}}">
                        <materialDesign:PackIcon Kind="CheckCircle" Width="18" Height="18" Margin="0 1 10 0"
                                                 VerticalAlignment="Top" Foreground="LimeGreen"/>
                        <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" FontSize="13"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MaterialDesign.Brush.Foreground}"/>
                        <Button Margin="12 0 0 0" Height="30" Padding="10 0" VerticalAlignment="Center"
                                Style="{StaticResource MaterialDesignOutlinedButton}"
                                Command="{Binding OpenOutputFolderCommand}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Kind="FolderOpen" Width="14" Height="14" Margin="0 0 6 0"
                                                         VerticalAlignment="Center"/>
                                <TextBlock Text="{loc:Tr VideoView_OpenFolder}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
